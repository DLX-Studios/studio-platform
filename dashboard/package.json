{
  "name": "studio-builder-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "start": "bun --bun ./build/index.js",
    "prepare": "svelte-kit sync || true",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@bradenmacdonald/s3-lite-client": "^1.0.0",
    "@digitalocean/dots": "^1.19.0",
    "bits-ui": "^2.19.0",
    "motion": "^13.1.1",
    "phosphor-svelte": "^3.1.0",
    "svelte-motion": "^0.12.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-bun": "^1.0.0-next.1",
    "@sveltejs/kit": "^3.0.0-next.25",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "download"
    }
  }
}
