<script lang="ts">
  let teeCount = $state(0);
  let jeansCount = $state(0);
  let jacketCount = $state(0);
  let bagCount = $derived(teeCount + jeansCount + jacketCount);
  let bagTotal = $derived(teeCount * 2999 + jeansCount * 8900 + jacketCount * 14900);

  function addTee() {
    teeCount += 1;
  }

  function addJeans() {
    jeansCount += 1;
  }

  function addJacket() {
    jacketCount += 1;
  }
</script>

