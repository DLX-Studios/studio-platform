# DigitalOcean
DIGITALOCEAN_TOKEN=dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DO_SNAPSHOT_ID=12345678
DO_SSH_KEY_IDS=12345678,87654321
DO_REGION=nyc3
DO_SIZE=c-8

# GitHub (fine-grained PAT with Contents:Read on your repo)
GITHUB_REPO=yourusername/studio-canvas
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DigitalOcean Spaces (S3-compatible) for sccache persistence
SCCACHE_BUCKET=studio-cache
SCCACHE_REGION=nyc3
SCCACHE_ENDPOINT=nyc3.digitaloceanspaces.com
SPACES_ACCESS_KEY_ID=XXXXXXXXXXXXXXXXXXXX
SPACES_SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Estimated cost per hour for your default size (used by analytics only)
COST_PER_HOUR=0.143
