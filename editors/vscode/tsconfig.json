{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "types": [
      "vscode",
      "node",
      "bun-types"
    ]
  },
  "include": [
    "src"
  ]
}