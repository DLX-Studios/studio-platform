{
  "name": "Studio Script",
  "scopeName": "source.studio",
  "fileTypes": ["studio"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#script" },
    { "include": "#control" },
    { "include": "#component" },
    { "include": "#interpolation" },
    { "include": "#string" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.block.studio",
          "begin": "<!--",
          "end": "-->"
        }
      ]
    },
    "script": {
      "patterns": [
        {
          "name": "meta.tag.script.studio",
          "begin": "(<)(script)(?![\\w-])",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.studio" },
            "2": { "name": "entity.name.tag.studio" }
          },
          "end": "(</)(script)(>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.studio" },
            "2": { "name": "entity.name.tag.studio" },
            "3": { "name": "punctuation.definition.tag.studio" }
          },
          "patterns": [{ "include": "source.ts" }]
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "keyword.control.studio",
          "match": "\\{#(if|each|await|key|snippet)\\b|\\{:(else|then|catch)\\b|\\{/\\w+\\}"
        }
      ]
    },
    "component": {
      "patterns": [
        {
          "name": "entity.name.tag.studio",
          "match": "</?[A-Z][A-Za-z0-9]*"
        },
        {
          "name": "entity.other.attribute-name.studio",
          "match": "\\b(onclick|onchange|onsubmit|[a-zA-Z][a-zA-Z0-9-]*)\\b(?=\\s*=)"
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "variable.interpolation.studio",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [{ "include": "source.ts" }]
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.studio",
          "begin": "\"",
          "end": "\""
        }
      ]
    }
  }
}
